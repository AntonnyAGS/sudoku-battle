{
  "name": "sudoku-battle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "NX_NATIVE_COMMAND_RUNNER=false nx run-many -t serve -p codex-poc-api,codex-poc-frontend --parallel=2 --output-style=stream",
    "lint": "nx run-many -t lint && tsx tools/verify-boundaries.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "test": "jest --config jest.backend.config.cjs --runInBand && jest --config jest.frontend.config.cjs --runInBand && jest --config jest.contracts.config.cjs --runInBand",
    "test:coverage": "jest --config jest.backend.config.cjs --runInBand --coverage && jest --config jest.frontend.config.cjs --runInBand --coverage && jest --config jest.contracts.config.cjs --runInBand --coverage",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:e2e": "pnpm build && playwright test",
    "build": "nx run-many -t build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:integration && pnpm build && playwright test",
    "security:scan": "pnpm dlx @openai/codex-security@0.2.0 scan .",
    "security:scan:dry-run": "pnpm dlx @openai/codex-security@0.2.0 scan . --dry-run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "helmet": "8.3.0",
    "pino-http": "11.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "nx": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nestjs/testing": "11.2.7",
    "@pulumi/pulumi": "3.268.0",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.56.1",
    "@eslint/js": "9.39.1",
    "prettier": "3.8.1",
    "husky": "9.1.7",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.6",
    "jest-environment-jsdom": "29.7.0",
    "@types/jest": "29.5.14",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/express": "5.0.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "@playwright/test": "1.58.2",
    "tsx": "4.21.0",
    "tsc-alias": "1.8.16",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0"
  }
}
